name=exfatprogs
version=1.4.5
release=1
source="https://github.com/$name/$name/releases/download/$version/$name-$version.tar.xz"

build() {
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--mandir=/usr/share/man
	# with e2fsprogs blkid configure sets EXT2_BLKID_* but mkfs only uses BLKID_*
	make \
		BLKID_CFLAGS="$(pkg-config --cflags blkid)" \
		BLKID_LIBS="$(pkg-config --libs blkid)"
	make DESTDIR=$PKG install
}
