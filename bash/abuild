name=bash
version=5.3p20
release=1
source="https://ftp.gnu.org/gnu/${name}/${name}-${version%p*}.tar.gz
	$(b=${version%p*}; p=${version#*p}; i=1; while [ $i -le $p ]; do
		printf "https://ftp.gnu.org/gnu/%s/%s-%s-patches/%s%s-%03d\n" \
			"$name" "$name" "$b" "$name" "${b/./}" "$i"
		i=$((i+1))
	done)
	bashrc"
build_opt="--without-bash-malloc --with-installed-readline"

prebuild() {
	for p in $SRC/*-0??; do
		patch -Np0 -i $p
	done
}

postbuild() {
	mkdir -p $PKG/bin
	mv $PKG/usr/bin/bash $PKG/bin
	
	install -d $PKG/etc
	install -m644 $SRC/bashrc $PKG/etc
}
