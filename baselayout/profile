# /etc/profile

# Set the initial path
export PATH=/bin:/usr/bin:/sbin:/usr/sbin

# Set umask
umask 022

# Export /etc/environment variables
if [ -r /etc/environment ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '#'*|'') continue ;;
        esac
        export "$line"
    done < /etc/environment
fi

for script in /etc/profile.d/*.sh ; do
    if [ -r $script ] ; then
        . $script
    fi
    unset script
done
