+def _parent_disk(dev):
+	'''Return the top-level block device name behind a /dev path.'''
+	try:
+		name = os.path.basename(os.path.realpath(dev))
+		sysblock = os.path.join('/sys/class/block', name)
+		if os.path.exists(os.path.join(sysblock, 'partition')):
+			return os.path.basename(os.path.dirname(os.path.realpath(sysblock)))
+		return name
+	except Exception:
+		return None
+
+def _find_mounts_without_lsblk():
+	'''Map xfs mountpoints to disks without util-linux lsblk.'''
+	fs = {}
+	try:
+		with open('/proc/self/mounts', 'r') as f:
+			lines = f.readlines()
+	except Exception:
+		return fs
+	for line in lines:
+		fields = line.split()
+		if len(fields) < 3 or fields[2] != 'xfs':
+			continue
+		dev = fields[0]
+		if not dev.startswith('/dev/'):
+			continue
+		mnt = fields[1]
+		mnt = mnt.replace('\\040', ' ').replace('\\011', '\t')
+		mnt = mnt.replace('\\012', '\n').replace('\\134', '\\')
+		disk = _parent_disk(dev)
+		if disk is None:
+			continue
+		if mnt in fs:
+			fs[mnt].add(disk)
+		else:
+			fs[mnt] = set([disk])
+	return fs
+
